generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  employeeCode String?  @unique @map("employee_code")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                       UserRole[]
  staff                       Staff?
  createdStaffWardPermissions StaffWardPermission[]    @relation("StaffWardPermissionCreatedBy")
  submittedWardPreparations   WardCyclePreparation[]   @relation("WardPreparationSubmittedBy")
  selectedExternalStaff       WardCycleExternalStaff[] @relation("ExternalStaffSelectedBy")
  createdScheduleVersions     ScheduleVersion[]        @relation("ScheduleVersionCreatedBy")
  manualChanges               ScheduleManualChange[]   @relation("ManualChangeChangedBy")
  auditLogs                   AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Ward {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff                 Staff[]
  permissions           StaffWardPermission[]
  preparations          WardCyclePreparation[]
  externalStaff         WardCycleExternalStaff[]
  assignments           ScheduleAssignment[]
  compensationSummaries WardCompensationSummary[]
  violations            GaViolation[]

  @@map("wards")
}

model Staff {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @unique @map("user_id") @db.Uuid
  staffCode    String   @unique @map("staff_code")
  fullName     String   @map("full_name")
  homeWardId   String   @map("home_ward_id") @db.Uuid
  position     String?
  payPosition  String?  @map("pay_position")
  otRate       Decimal  @default(0) @map("ot_rate") @db.Decimal(12, 2)
  shiftPayRate Decimal  @default(0) @map("shift_pay_rate") @db.Decimal(12, 2)
  isHead       Boolean  @default(false) @map("is_head")
  isTrainee    Boolean  @default(false) @map("is_trainee")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user                 User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  homeWard             Ward                     @relation(fields: [homeWardId], references: [id])
  wardPermissions      StaffWardPermission[]
  snapshots            WardStaffSnapshot[]
  externalSelections   WardCycleExternalStaff[]
  availabilityRequests AvailabilityRequest[]
  assignments          ScheduleAssignment[]
  violations           GaViolation[]

  @@index([homeWardId])
  @@map("staff")
}

model StaffWardPermission {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  wardId    String   @map("ward_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  staff   Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  ward    Ward  @relation(fields: [wardId], references: [id], onDelete: Cascade)
  creator User? @relation("StaffWardPermissionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([staffId, wardId])
  @@map("staff_ward_permissions")
}

model ScheduleCycle {
  id               String    @id @default(uuid()) @db.Uuid
  year             Int
  month            Int
  status           String    @default("preparing")
  requestOpenDate  DateTime? @map("request_open_date") @db.Date
  requestCloseDate DateTime? @map("request_close_date") @db.Date
  dataLockDate     DateTime? @map("data_lock_date") @db.Date
  autoGenerateAt   DateTime? @map("auto_generate_at")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  preparations         WardCyclePreparation[]
  externalStaff        WardCycleExternalStaff[]
  availabilityRequests AvailabilityRequest[]
  holidays             ScheduleCycleHoliday[]
  gaRuns               GaRun[]
  scheduleVersions     ScheduleVersion[]

  @@unique([year, month])
  @@map("schedule_cycles")
}

model ScheduleCycleHoliday {
  id          String   @id @default(uuid()) @db.Uuid
  cycleId     String   @map("cycle_id") @db.Uuid
  holidayDate DateTime @map("holiday_date") @db.Date
  label       String?
  createdAt   DateTime @default(now()) @map("created_at")

  cycle ScheduleCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, holidayDate])
  @@index([cycleId])
  @@map("schedule_cycle_holidays")
}

model WardCyclePreparation {
  id          String    @id @default(uuid()) @db.Uuid
  cycleId     String    @map("cycle_id") @db.Uuid
  wardId      String    @map("ward_id") @db.Uuid
  status      String    @default("draft")
  submittedBy String?   @map("submitted_by") @db.Uuid
  submittedAt DateTime? @map("submitted_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  cycle                ScheduleCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  ward                 Ward                  @relation(fields: [wardId], references: [id], onDelete: Cascade)
  submitter            User?                 @relation("WardPreparationSubmittedBy", fields: [submittedBy], references: [id], onDelete: SetNull)
  staffingRequirements StaffingRequirement[]
  staffSnapshots       WardStaffSnapshot[]

  @@unique([cycleId, wardId])
  @@map("ward_cycle_preparations")
}

model StaffingRequirement {
  id          String   @id @default(uuid()) @db.Uuid
  wardCycleId String   @map("ward_cycle_id") @db.Uuid
  shiftCode   String   @map("shift_code")
  minStaff    Int      @map("min_staff")
  maxStaff    Int      @map("max_staff")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  wardCycle WardCyclePreparation @relation(fields: [wardCycleId], references: [id], onDelete: Cascade)

  @@unique([wardCycleId, shiftCode])
  @@map("staffing_requirements")
}

model WardCycleExternalStaff {
  id         String   @id @default(uuid()) @db.Uuid
  cycleId    String   @map("cycle_id") @db.Uuid
  wardId     String   @map("ward_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  selectedBy String?  @map("selected_by") @db.Uuid
  selectedAt DateTime @default(now()) @map("selected_at")

  cycle    ScheduleCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  ward     Ward          @relation(fields: [wardId], references: [id], onDelete: Cascade)
  staff    Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  selector User?         @relation("ExternalStaffSelectedBy", fields: [selectedBy], references: [id], onDelete: SetNull)

  @@unique([cycleId, wardId, staffId])
  @@map("ward_cycle_external_staff")
}

model WardStaffSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  wardCycleId      String   @map("ward_cycle_id") @db.Uuid
  staffId          String?  @map("staff_id") @db.Uuid
  staffCode        String   @map("staff_code")
  fullName         String   @map("full_name")
  homeWardName     String   @map("home_ward_name")
  allowedWardsText String   @map("allowed_wards_text")
  position         String?
  payPosition      String?  @map("pay_position")
  otRate           Decimal  @default(0) @map("ot_rate") @db.Decimal(12, 2)
  shiftPayRate     Decimal  @default(0) @map("shift_pay_rate") @db.Decimal(12, 2)
  isHead           Boolean  @default(false) @map("is_head")
  isTrainee        Boolean  @default(false) @map("is_trainee")
  createdAt        DateTime @default(now()) @map("created_at")

  wardCycle WardCyclePreparation @relation(fields: [wardCycleId], references: [id], onDelete: Cascade)
  staff     Staff?               @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([wardCycleId])
  @@map("ward_staff_snapshots")
}

model AvailabilityRequest {
  id             String   @id @default(uuid()) @db.Uuid
  cycleId        String   @map("cycle_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  requestDate    DateTime @map("request_date") @db.Date
  requestType    String   @map("request_type")
  preferredShift String?  @map("preferred_shift")
  reason         String?
  status         String   @default("submitted")
  submittedAt    DateTime @default(now()) @map("submitted_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cycle ScheduleCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  staff Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([cycleId, staffId])
  @@map("availability_requests")
}

model GaRun {
  id               String    @id @default(uuid()) @db.Uuid
  cycleId          String    @map("cycle_id") @db.Uuid
  status           String    @default("queued")
  generationCount  Int?      @map("generation_count")
  objective        Decimal?  @db.Decimal(20, 4)
  fitness          Decimal?  @db.Decimal(20, 10)
  inputSnapshot    Json?     @map("input_snapshot")
  settingsSnapshot Json?     @map("settings_snapshot")
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  cycle            ScheduleCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  scheduleVersions ScheduleVersion[]
  violations       GaViolation[]

  @@index([cycleId, status])
  @@map("ga_runs")
}

model GaSetting {
  id                         String   @id @default(uuid()) @db.Uuid
  profileKey                 String   @unique @map("profile_key")
  profileName                String   @map("profile_name")
  isActive                   Boolean  @default(false) @map("is_active")
  populationSize             Int      @map("population_size")
  generations                Int
  patience                   Int
  eliteSize                  Int      @map("elite_size")
  tournamentSize             Int      @map("tournament_size")
  crossoverRate              Decimal  @map("crossover_rate") @db.Decimal(8, 4)
  mutationRate               Decimal  @map("mutation_rate") @db.Decimal(8, 6)
  fullRepairEvery            Int      @default(4) @map("full_repair_every")
  repairEliteEvery           Int      @default(8) @map("repair_elite_every")
  randomSeed                 Int?     @map("random_seed")
  maxSeconds                 Int      @map("max_seconds")
  maxShiftsPer7Days          Int      @map("max_shifts_per_7_days")
  weeklyMinDaysOff           Int      @map("weekly_min_days_off")
  maxConsecutiveNights       Int      @map("max_consecutive_nights")
  maxConsecutiveWorkDays     Int      @map("max_consecutive_work_days")
  maxTraineePerShift         Int      @map("max_trainee_per_shift")
  minRestHours               Int      @map("min_rest_hours")
  workloadBalanceMaxDiff     Int      @map("workload_balance_max_diff")
  shiftCountBalanceMaxDiff   Int      @map("shift_count_balance_max_diff")
  shiftTypeBalanceMaxDiff    Int      @map("shift_type_balance_max_diff")
  targetOffDaysPerStaff      Int?     @map("target_off_days_per_staff")
  enableMorningEveningDouble Boolean  @default(false) @map("enable_morning_evening_double")
  enableNightEveningDouble   Boolean  @default(false) @map("enable_night_evening_double")
  preferMorningOt            Boolean  @default(true) @map("prefer_morning_ot")
  morningRegularRequired     Boolean  @default(true) @map("morning_regular_required")
  updatedBy                  String?  @map("updated_by") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("ga_settings")
}

model ScheduleVersion {
  id              String    @id @default(uuid()) @db.Uuid
  cycleId         String    @map("cycle_id") @db.Uuid
  gaRunId         String?   @map("ga_run_id") @db.Uuid
  parentVersionId String?   @map("parent_version_id") @db.Uuid
  versionNo       Int       @map("version_no")
  source          String
  status          String    @default("draft")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  publishedAt     DateTime? @map("published_at")

  cycle                 ScheduleCycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  gaRun                 GaRun?                    @relation(fields: [gaRunId], references: [id], onDelete: SetNull)
  parentVersion         ScheduleVersion?          @relation("ScheduleVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions         ScheduleVersion[]         @relation("ScheduleVersionParent")
  creator               User?                     @relation("ScheduleVersionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  assignments           ScheduleAssignment[]
  manualChanges         ScheduleManualChange[]
  compensationSummaries WardCompensationSummary[]

  @@unique([cycleId, versionNo])
  @@index([cycleId, status])
  @@map("schedule_versions")
}

model ScheduleAssignment {
  id                String   @id @default(uuid()) @db.Uuid
  scheduleVersionId String   @map("schedule_version_id") @db.Uuid
  staffId           String   @map("staff_id") @db.Uuid
  wardId            String   @map("ward_id") @db.Uuid
  workDate          DateTime @map("work_date") @db.Date
  shiftCode         String   @map("shift_code")
  isOt              Boolean  @default(false) @map("is_ot")
  otShifts          String?  @map("ot_shifts")
  payAmount         Decimal  @default(0) @map("pay_amount") @db.Decimal(12, 2)
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  scheduleVersion ScheduleVersion        @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  staff           Staff                  @relation(fields: [staffId], references: [id])
  ward            Ward                   @relation(fields: [wardId], references: [id])
  manualChanges   ScheduleManualChange[]

  @@unique([scheduleVersionId, staffId, workDate])
  @@index([scheduleVersionId, wardId, workDate])
  @@map("schedule_assignments")
}

model ScheduleManualChange {
  id                String    @id @default(uuid()) @db.Uuid
  scheduleVersionId String    @map("schedule_version_id") @db.Uuid
  assignmentId      String?   @map("assignment_id") @db.Uuid
  actionType        String    @map("action_type")
  oldStaffId        String?   @map("old_staff_id") @db.Uuid
  newStaffId        String?   @map("new_staff_id") @db.Uuid
  oldWardId         String?   @map("old_ward_id") @db.Uuid
  newWardId         String?   @map("new_ward_id") @db.Uuid
  oldWorkDate       DateTime? @map("old_work_date") @db.Date
  newWorkDate       DateTime? @map("new_work_date") @db.Date
  oldShiftCode      String?   @map("old_shift_code")
  newShiftCode      String?   @map("new_shift_code")
  reason            String?
  changedBy         String?   @map("changed_by") @db.Uuid
  changedAt         DateTime  @default(now()) @map("changed_at")

  scheduleVersion ScheduleVersion     @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  assignment      ScheduleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  changer         User?               @relation("ManualChangeChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([scheduleVersionId])
  @@map("schedule_manual_changes")
}

model WardCompensationSummary {
  id                      String   @id @default(uuid()) @db.Uuid
  scheduleVersionId       String   @map("schedule_version_id") @db.Uuid
  wardId                  String   @map("ward_id") @db.Uuid
  totalOtAmount           Decimal  @default(0) @map("total_ot_amount") @db.Decimal(14, 2)
  totalRegularShiftAmount Decimal  @default(0) @map("total_regular_shift_amount") @db.Decimal(14, 2)
  totalAmount             Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  calculatedAt            DateTime @default(now()) @map("calculated_at")

  scheduleVersion ScheduleVersion           @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  ward            Ward                      @relation(fields: [wardId], references: [id])
  items           CompensationSummaryItem[]

  @@unique([scheduleVersionId, wardId])
  @@map("ward_compensation_summaries")
}

model CompensationSummaryItem {
  id        String  @id @default(uuid()) @db.Uuid
  summaryId String  @map("summary_id") @db.Uuid
  category  String
  staffType String? @map("staff_type")
  rate      Decimal @default(0) @db.Decimal(12, 2)
  quantity  Int
  amount    Decimal @default(0) @db.Decimal(14, 2)

  summary WardCompensationSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId, category])
  @@map("compensation_summary_items")
}

model GaViolation {
  id             String    @id @default(uuid()) @db.Uuid
  gaRunId        String    @map("ga_run_id") @db.Uuid
  staffId        String?   @map("staff_id") @db.Uuid
  wardId         String?   @map("ward_id") @db.Uuid
  violationDate  DateTime? @map("violation_date") @db.Date
  constraintCode String    @map("constraint_code")
  severity       String
  message        String
  penalty        Decimal   @default(0) @db.Decimal(14, 2)
  createdAt      DateTime  @default(now()) @map("created_at")

  gaRun GaRun  @relation(fields: [gaRunId], references: [id], onDelete: Cascade)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  ward  Ward?  @relation(fields: [wardId], references: [id], onDelete: SetNull)

  @@index([gaRunId, severity])
  @@map("ga_violations")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
